/-- The correspondence polynomial `Ψ(Y, X) = Π_j (Y - x((τ+j)/7))`. -/
def psi {R : Type*} [CommRing R] (Y X : R) : R :=
  Y ^ 7 - eK 1 X * Y ^ 6 + eK 2 X * Y ^ 5 - eK 3 X * Y ^ 4 + eK 4 X * Y ^ 3 - eK 5 X * Y ^ 2 +
    eK 6 X * Y - eK 7 X

