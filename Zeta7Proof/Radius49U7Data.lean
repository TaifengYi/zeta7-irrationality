      ((qM 3 2 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 2 * X ^ 1 +
      ((qM 3 3 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 3 * X ^ 0 - ((1 / 49 : ℚ) : F) ^ 3 := by
