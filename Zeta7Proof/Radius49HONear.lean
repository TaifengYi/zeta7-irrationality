theorem qP_near_bnd {s : ℝ} (hs0 : 0 < s) (hs : s ≤ 1 / 4) (n : ℕ) (hn : n ≤ 6) :
    Bnd ((7 : ℝ) ^ (7 * s)) (qP n (X : ℚ_[7]⟦X⟧))
      ((7 : ℝ) ^ (-(2 : ℤ)) * ((7 : ℝ) ^ s) ^ (n + 21)) := by
  interval_cases n
  exacts [qP_near_bnd_0 hs0 hs, qP_near_bnd_1 hs0 hs, qP_near_bnd_2 hs0 hs, qP_near_bnd_3 hs0 hs,
    qP_near_bnd_4 hs0 hs, qP_near_bnd_5 hs0 hs, qP_near_bnd_6 hs0 hs]

theorem improve_eq_seven {s : ℝ} (hs : s ≤ 1 / 4) : improve s = 7 * s := improve_small hs

theorem Fcol_near_base {s : ℝ} (hs0 : 0 < s) (hs : s ≤ 1 / 4) (n : ℕ) (hn : n ≤ 6) :
    Bnd ((7 : ℝ) ^ (7 * s)) (Fcol n) (((7 : ℝ) ^ s) ^ 14 * ((7 : ℝ) ^ s) ^ n) := by
  have hρ : 0 < (7 : ℝ) ^ (7 * s) := by positivity
  have hG := Bnd_of_X_mul hρ norm_49 (qP_near_bnd hs0 hs n hn) (Fcol_base n hn)
  have hval : 49 * ((7 : ℝ) ^ (-(2 : ℤ)) * ((7 : ℝ) ^ s) ^ (n + 21)) / (7 : ℝ) ^ (7 * s) =
      ((7 : ℝ) ^ s) ^ 14 * ((7 : ℝ) ^ s) ^ n := by
    have h7s : (7 : ℝ) ^ (7 * s) = ((7 : ℝ) ^ s) ^ 7 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; ring_nf
    rw [h7s]
    have hpos : 0 < (7 : ℝ) ^ s := by positivity
    field_simp
    norm_num
    ring
  rw [hval] at hG
  have hs2 : s < 2 := by linarith
  apply Bnd_of_mul_dominant hρ (D := polyNg X ^ 2) (G := polyNg X ^ 2 * Fcol n)
  · rw [polyNg_sq_eq]; simp
  · intro l hl
    rw [polyNg_sq_eq, map_add, coeff_one, ite_cond_eq_false _ _ (eq_false (by omega)), zero_add]
    have := Nprime_bnd hs2 l
    rwa [improve_eq_seven hs] at this
  · exact hG
  · rfl

/-- **Near-ordinary column bound.** -/
theorem Fcol_near {s : ℝ} (hs0 : 0 < s) (hs : s ≤ 1 / 4) (n : ℕ) :
    Bnd ((7 : ℝ) ^ (7 * s)) (Fcol n) (((7 : ℝ) ^ s) ^ 14 * ((7 : ℝ) ^ s) ^ n) := by
  have hρ : 0 < (7 : ℝ) ^ (7 * s) := by positivity
  set R : ℝ := (7 : ℝ) ^ s
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases hn : n ≤ 6
    · exact Fcol_near_base hs0 hs n hn
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 7 := ⟨n - 7, by omega⟩
      rw [Fcol_rec]
      have term : ∀ j : ℕ, 1 ≤ j → j ≤ 7 →
          Bnd ((7 : ℝ) ^ (7 * s)) (eK j X * Fcol (m + 7 - j)) (R ^ 14 * R ^ (m + 7)) := by
        intro j hj1 hj7
        have he := eK_bnd hs0 j ⟨hj1, hj7⟩
        rw [improve_eq_seven hs] at he
        have := he.mul hρ (ih (m + 7 - j) (by omega))
        refine this.mono (le_of_eq ?_)
        rw [show R ^ j * (R ^ 14 * R ^ (m + 7 - j)) = R ^ 14 * (R ^ j * R ^ (m + 7 - j)) by ring,
          ← pow_add]
        congr 2; omega
      have t1 := term 1 le_rfl (by norm_num)
      have t2 := term 2 (by norm_num) (by norm_num)
      have t3 := term 3 (by norm_num) (by norm_num)
      have t4 := term 4 (by norm_num) (by norm_num)
      have t5 := term 5 (by norm_num) (by norm_num)
      have t6 := term 6 (by norm_num) (by norm_num)
      have t7 := term 7 (by norm_num) (by norm_num)
      simp only [show m + 7 - 1 = m + 6 by omega, show m + 7 - 2 = m + 5 by omega,
        show m + 7 - 3 = m + 4 by omega, show m + 7 - 4 = m + 3 by omega,
        show m + 7 - 5 = m + 2 by omega, show m + 7 - 6 = m + 1 by omega,
        show m + 7 - 7 = m by omega] at t1 t2 t3 t4 t5 t6 t7
      exact (((((t1.sub hρ.le t2).add hρ.le t3).sub hρ.le t4).add hρ.le t5).sub hρ.le t6).add
        hρ.le t7

/-- The coefficient formula of the twisted operator for an arbitrary series. -/
theorem twistLin_coeff (f : ℚ_[7]⟦X⟧) (i : ℕ) :
    coeff i (twistLin f) = ∑ n ∈ Finset.range (7 * i + 1), twistMatrix i n * coeff n f := by
  set N := 7 * i + 1
  set T : ℚ_[7]⟦X⟧ := ∑ n ∈ Finset.range N, coeff n f • X ^ n with hT
  have hR : X ^ N ∣ f - T := by
    rw [X_pow_dvd_iff]
    intro m hm
    rw [map_sub, hT, map_sum]
    simp only [map_smul, coeff_X_pow, smul_eq_mul, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq, ite_cond_eq_true _ _ (eq_true (Finset.mem_range.mpr hm)), sub_self]
  have hsplit : f = T + (f - T) := by ring
  conv_lhs => rw [hsplit, map_add, map_add, coeff_twistLin_eq_zero hR, add_zero, hT, map_sum,
    map_sum]
  apply Finset.sum_congr rfl
  intro n _
  rw [map_smul, map_smul, smul_eq_mul, twistMatrix, mul_comm]

/-- **Near-ordinary operator bound.** -/
theorem twistLin_near {s : ℝ} (hs0 : 0 < s) (hs : s ≤ 1 / 4) {f : ℚ_[7]⟦X⟧} {B : ℝ}
    (hf : Bnd ((7 : ℝ) ^ s) f B) :
    Bnd ((7 : ℝ) ^ (7 * s)) (twistLin f) (((7 : ℝ) ^ s) ^ 14 * B) := by
  have hB := hf.nonneg
  set R : ℝ := (7 : ℝ) ^ s
  have hR : 0 < R := by positivity
  intro i
  have hpos : 0 < ((7 : ℝ) ^ (7 * s)) ^ i := by positivity
  rw [twistLin_coeff, ← le_div_iff₀ hpos]
  apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity)
  intro n _
  rw [le_div_iff₀ hpos, norm_mul]
  have ht := Fcol_near hs0 hs n i
  change ‖twistMatrix i n‖ * ((7 : ℝ) ^ (7 * s)) ^ i ≤ R ^ 14 * R ^ n at ht
  have hfn := hf n
  have hRn : 0 < R ^ n := pow_pos hR n
  calc ‖twistMatrix i n‖ * ‖coeff n f‖ * ((7 : ℝ) ^ (7 * s)) ^ i
      = (‖twistMatrix i n‖ * ((7 : ℝ) ^ (7 * s)) ^ i) * ‖coeff n f‖ := by ring
    _ ≤ (R ^ 14 * R ^ n) * ‖coeff n f‖ :=
        mul_le_mul_of_nonneg_right ht (norm_nonneg _)
    _ = R ^ 14 * (‖coeff n f‖ * R ^ n) := by ring
    _ ≤ R ^ 14 * B := mul_le_mul_of_nonneg_left hfn (by positivity)

