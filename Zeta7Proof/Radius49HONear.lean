import Zeta7Proof.Radius49HM

/-! Radius internalization, HO step (i): the near-ordinary estimate for the twisted `U₇`.

For `0 < s ≤ 1/4` (so `improve s = 7s`) every twisted column satisfies
`Bnd (7^{7s}) (Fcol n) ((7^s)^14 · (7^s)^n)` (`Fcol_near`): the only loss is the factor
`(7^s)^14`, which tends to `1` as `s → 0`. Consequently (`twistLin_near`)
`Bnd (7^s) f B → Bnd (7^{7s}) (twistLin f) ((7^s)^14 · B)` for every series `f`.
No published radius input is used. -/

noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 0
set_option linter.style.longLine false
open PowerSeries
namespace Zeta7Radius49
open Zeta7Main
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩

theorem expo_near {s : ℝ} (hs0 : 0 < s) (hs : s ≤ 1 / 4) (v j n : ℕ) (h1 : 2 ≤ v)
    (h2 : 7 * j ≤ 4 * (v - 2) + n + 21) :
    (7 : ℝ) ^ (-(v : ℤ)) * ((7 : ℝ) ^ (7 * s)) ^ j ≤
      (7 : ℝ) ^ (-(2 : ℤ)) * ((7 : ℝ) ^ s) ^ (n + 21) := by
  have h7 : (1 : ℝ) < 7 := by norm_num
  rw [← Real.rpow_natCast, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num),
    ← Real.rpow_mul (by norm_num), ← Real.rpow_intCast, ← Real.rpow_intCast,
    ← Real.rpow_add (by norm_num), ← Real.rpow_add (by norm_num)]
  apply Real.rpow_le_rpow_of_exponent_le h7.le
  obtain ⟨w, rfl⟩ : ∃ w, v = w + 2 := ⟨v - 2, by omega⟩
  have h2' : (7 : ℝ) * j ≤ 4 * w + n + 21 := by
    have : 7 * j ≤ 4 * w + n + 21 := by simpa using h2
    exact_mod_cast this
  push_cast
  rcases le_total ((7 : ℝ) * j) (n + 21) with hc | hc
  · nlinarith
  · nlinarith

