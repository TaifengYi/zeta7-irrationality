def polyPc {R : Type*} [CommRing R] (X : R) : R := 1 + 13 * X + 49 * X ^ 2
def polyNc {R : Type*} [CommRing R] (X : R) : R := 1 + 245 * X + 2401 * X ^ 2

theorem trace_cert_1 {F : Type*} [Field F] [CharZero F] (X : F) :
    X ^ 1 * pM 1 X = ((qM 1 0 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 0 * X ^ 1 +
      ((qM 1 1 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 1 * X ^ 0 - ((1 / 49 : ℚ) : F) ^ 1 := by
  simp only [pM, qM, polyPc, polyNc]; push_cast; ring

theorem trace_cert_2 {F : Type*} [Field F] [CharZero F] (X : F) :
    X ^ 2 * pM 2 X = ((qM 2 0 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 0 * X ^ 2 +
      ((qM 2 1 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 1 * X ^ 1 +
      ((qM 2 2 : ℚ) : F) * (polyPc X * polyNc X ^ 3) ^ 2 * X ^ 0 - ((1 / 49 : ℚ) : F) ^ 2 := by
  simp only [pM, qM, polyPc, polyNc]; push_cast; ring

