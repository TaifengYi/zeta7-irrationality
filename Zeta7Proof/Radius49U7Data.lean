theorem newton_1 {R : Type*} [CommRing R] (X : R) :
    (1 : R) * eK 1 X = (1 * pM 1 X) := by
  simp only [eK, pM] <;> ring

theorem newton_2 {R : Type*} [CommRing R] (X : R) :
    (2 : R) * eK 2 X = (eK 1 X * pM 1 X) - (1 * pM 2 X) := by
  simp only [eK, pM] <;> ring

theorem newton_3 {R : Type*} [CommRing R] (X : R) :
    (3 : R) * eK 3 X = (eK 2 X * pM 1 X) - (eK 1 X * pM 2 X) + (1 * pM 3 X) := by
  simp only [eK, pM] <;> ring

theorem newton_4 {R : Type*} [CommRing R] (X : R) :
    (4 : R) * eK 4 X = (eK 3 X * pM 1 X) - (eK 2 X * pM 2 X) + (eK 1 X * pM 3 X) - (1 * pM 4 X) := by
