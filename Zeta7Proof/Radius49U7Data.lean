theorem newton_5 {R : Type*} [CommRing R] (X : R) :
    (5 : R) * eK 5 X = (eK 4 X * pM 1 X) - (eK 3 X * pM 2 X) + (eK 2 X * pM 3 X) - (eK 1 X * pM 4 X) + (1 * pM 5 X) := by
  simp only [eK, pM] <;> ring

theorem newton_6 {R : Type*} [CommRing R] (X : R) :
    (6 : R) * eK 6 X = (eK 5 X * pM 1 X) - (eK 4 X * pM 2 X) + (eK 3 X * pM 3 X) - (eK 2 X * pM 4 X) + (eK 1 X * pM 5 X) - (1 * pM 6 X) := by
